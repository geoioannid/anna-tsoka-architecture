---
import { getCollection } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FadeIn from '../components/FadeIn.astro';
import Footer from '../components/Footer.astro';
import { resolveUpload } from '../lib/images';
import { paragraphs } from '../lib/blocks';

const about = (await getCollection('about'))[0]?.data;
const settings = (await getCollection('settings'))[0]?.data;
const portrait = about?.portrait ? resolveUpload(about.portrait) : undefined;
const site = Astro.site ?? new URL('https://annatsoka.com');

// Same transform as the layout's og:image (sharp caches by parameters, so the
// crop is generated once); gives the Person markup a real, absolute image URL.
const portraitCard = portrait
  ? await getImage({
      src: portrait,
      width: 1200,
      height: 630,
      fit: 'cover',
      format: 'jpeg',
      quality: 80,
    })
  : undefined;

// Google's ProfilePage feature: the about page is the profile of the person
// behind the studio (rich-results "profile page" structured data).
const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Anna Tsoka',
    jobTitle: 'Architect',
    alternateName: 'Anna Tsoka Architecture',
    worksFor: { '@type': 'Organization', name: 'Anna Tsoka Architecture', url: site.href },
    ...(portraitCard ? { image: new URL(portraitCard.src, site).href } : {}),
    ...(settings?.instagram ? { sameAs: [settings.instagram] } : {}),
  },
};
---

<BaseLayout
  title="About — Anna Tsoka Architecture"
  description="About the studio — a practice for architecture and interiors, working across residential, restoration and small public projects."
  image={about?.portrait}
  jsonLd={profile}
>
  <Nav />
  <main class="pt-32 pb-32 md:pt-48 md:pb-48">
    <div class="mx-auto max-w-[1600px] px-6 md:px-12">
      <div class="grid gap-16 md:grid-cols-12 md:gap-x-12">
        <FadeIn class="md:col-span-5 md:col-start-1">
          {portrait && (
            <Picture
              src={portrait}
              alt="Anna Tsoka — studio portrait"
              layout="constrained"
              width={613}
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              class="block h-auto w-full bg-muted"
            />
          )}
        </FadeIn>

        <FadeIn delay={120} class="md:col-span-6 md:col-start-7">
          <p class="text-xs tracking-widest uppercase text-muted-foreground">Studio</p>
          {about?.heading && (
            <h1 class="mt-6 text-2xl leading-[1.4] font-normal tracking-tight md:text-3xl">
              {about.heading}
            </h1>
          )}

          <div class="mt-10 max-w-xl space-y-6">
            {paragraphs(about?.bio ?? '').map((para) => (
              <p class="text-[15px] leading-[1.75] text-muted-foreground">{para}</p>
            ))}
          </div>

          <div class="mt-20 grid gap-16 md:grid-cols-2">
            <div>
              <p class="text-xs tracking-widest uppercase text-muted-foreground">Services</p>
              <ul class="mt-6 space-y-2 text-[15px]">
                {(about?.services ?? []).map((service) => (
                  <li>{service}</li>
                ))}
              </ul>
            </div>
            <div>
              <p class="text-xs tracking-widest uppercase text-muted-foreground">Contact</p>
              <ul class="mt-6 space-y-2 text-[15px]">
                {settings?.email && (
                  <li>
                    <a
                      href={`mailto:${settings.email}`}
                      class="underline underline-offset-4 hover:opacity-60"
                    >
                      {settings.email}
                    </a>
                  </li>
                )}
                {settings?.instagram && (
                  <li>
                    <a
                      href={settings.instagram}
                      target="_blank"
                      rel="noreferrer"
                      class="underline underline-offset-4 hover:opacity-60"
                    >
                      Instagram
                    </a>
                  </li>
                )}
                {settings?.city && <li class="text-muted-foreground">{settings.city}</li>}
              </ul>
            </div>
          </div>
        </FadeIn>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
