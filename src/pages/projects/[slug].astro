---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import FadeIn from '../../components/FadeIn.astro';
import Footer from '../../components/Footer.astro';
import { imageSize, isPortrait } from '../../lib/images';
import { chunkPairs, paragraphs } from '../../lib/blocks';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  const n = projects.length;
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: n > 1 ? projects[(i - 1 + n) % n] : undefined,
      next: n > 1 ? projects[(i + 1) % n] : undefined,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const d = project.data;
const phase = d.phaseCustom?.trim() || d.phase;

// Resolve image dimensions up front so the pair rule is decided at build time.
type SetImage = { image: string; caption?: string; portrait: boolean };
type RenderedBlock =
  | { kind: 'text'; title?: string; subtitle?: string; paragraphs: string[] }
  | { kind: 'images'; pairs: Array<[SetImage, SetImage] | [SetImage]> };

const renderedBlocks: RenderedBlock[] = [];
for (const block of d.blocks) {
  if (block.type === 'text') {
    renderedBlocks.push({
      kind: 'text',
      title: block.title,
      subtitle: block.subtitle,
      paragraphs: paragraphs(block.text),
    });
  } else {
    const images: SetImage[] = await Promise.all(
      block.images.map(async (im) => ({
        ...im,
        portrait: isPortrait(await imageSize(im.image)),
      })),
    );
    renderedBlocks.push({ kind: 'images', pairs: chunkPairs(images) });
  }
}
---

<BaseLayout
  title={`${d.title} — Anna Tsoka Architecture`}
  description={d.description || `${d.title}${d.location ? `, ${d.location}` : ''}${d.year ? `, ${d.year}` : ''}`}
  image={d.cover}
>
  <Nav />
  <main class="pt-32 md:pt-40">
    <!-- Header: image left, structured info right -->
    <section class="mx-auto max-w-[1600px] px-6 md:px-12">
      <div class="grid gap-12 md:grid-cols-12 md:gap-x-12">
        <FadeIn class="md:col-span-7">
          <div class="overflow-hidden bg-muted">
            <img src={d.cover} alt={d.title} fetchpriority="high" class="block h-auto w-full" />
          </div>
        </FadeIn>

        <FadeIn delay={120} class="md:col-span-5 md:pt-6">
          <h1 class="text-3xl leading-[1.15] font-normal tracking-tight md:text-5xl">{d.title}</h1>

          <dl class="mt-12 space-y-6 text-[13px] tracking-tight">
            {
              d.location && (
                <div>
                  <dt class="text-xs tracking-widest uppercase text-muted-foreground">Location</dt>
                  <dd class="mt-2">{d.location}</dd>
                </div>
              )
            }
            {
              d.year && (
                <div>
                  <dt class="text-xs tracking-widest uppercase text-muted-foreground">Year</dt>
                  <dd class="mt-2">{d.year}</dd>
                </div>
              )
            }
            <div>
              <dt class="text-xs tracking-widest uppercase text-muted-foreground">Phase</dt>
              <dd class="mt-2">{phase}</dd>
            </div>
          </dl>

          {
            d.description && (
              <p class="mt-12 text-[15px] leading-[1.75] text-muted-foreground">{d.description}</p>
            )
          }
        </FadeIn>
      </div>
    </section>

    <!-- Body: ordered text blocks and image sets -->
    <section class="mx-auto max-w-[1600px] px-6 pt-24 pb-32 md:px-12 md:pt-40 md:pb-48">
      <div class="space-y-24 md:space-y-40">
        {
          renderedBlocks.map((block, bi) =>
            block.kind === 'text' ? (
              <FadeIn key={bi} class="md:grid md:grid-cols-12">
                <div class="md:col-span-6 md:col-start-4">
                  {block.subtitle && (
                    <p class="text-xs tracking-widest uppercase text-muted-foreground">
                      {block.subtitle}
                    </p>
                  )}
                  {block.title && (
                    <h2 class="mt-4 text-2xl leading-[1.35] font-normal tracking-tight md:text-3xl">
                      {block.title}
                    </h2>
                  )}
                  <div class="mt-8 space-y-6">
                    {block.paragraphs.map((para, pi) => (
                      <p class="text-[15px] leading-[1.75] text-muted-foreground">{para}</p>
                    ))}
                  </div>
                </div>
              </FadeIn>
            ) : (
              <div key={bi} class="space-y-24 md:space-y-40">
                {block.pairs.map((pair, pai) =>
                  pair.length === 2 && (pair[0].portrait || pair[1].portrait) ? (
                    // At least one portrait in the pair: two-column row.
                    <FadeIn key={pai} class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:gap-12">
                      {pair.map((im) => (
                        <figure>
                          <img
                            src={im.image}
                            alt={im.caption || `${d.title}`}
                            loading="lazy"
                            class="block h-auto w-full bg-muted"
                          />
                          {im.caption && (
                            <figcaption class="mt-3 text-xs tracking-wide text-muted-foreground">
                              {im.caption}
                            </figcaption>
                          )}
                        </figure>
                      ))}
                    </FadeIn>
                  ) : (
                    // All-landscape pair (or a single leftover image): full width, stacked.
                    <div key={pai} class="space-y-24 md:space-y-40">
                      {pair.map((im) => (
                        <FadeIn>
                          <figure>
                            <img
                              src={im.image}
                              alt={im.caption || `${d.title}`}
                              loading="lazy"
                              class="block h-auto w-full bg-muted"
                            />
                            {im.caption && (
                              <figcaption class="mt-3 text-xs tracking-wide text-muted-foreground">
                                {im.caption}
                              </figcaption>
                            )}
                          </figure>
                        </FadeIn>
                      ))}
                    </div>
                  ),
                )}
              </div>
            ),
          )
        }
      </div>
    </section>

    <!-- Previous / next -->
    <nav class="border-t border-border" aria-label="Projects">
      <div
        class="mx-auto flex max-w-[1600px] items-center justify-between gap-6 px-6 py-16 md:px-12 md:py-24"
      >
        {
          prev && (
            <a href={`/projects/${prev.id}/`} class="group flex flex-col items-start">
              <span class="text-xs tracking-widest uppercase text-muted-foreground">← Previous</span>
              <span class="mt-3 text-lg font-normal tracking-tight transition-opacity group-hover:opacity-60 md:text-xl">
                {prev.data.title}
              </span>
            </a>
          )
        }
        <a
          href="/"
          class="hidden text-xs tracking-widest uppercase text-muted-foreground hover:text-foreground md:block"
        >
          Index
        </a>
        {
          next && (
            <a href={`/projects/${next.id}/`} class="group flex flex-col items-end text-right">
              <span class="text-xs tracking-widest uppercase text-muted-foreground">Next →</span>
              <span class="mt-3 text-lg font-normal tracking-tight transition-opacity group-hover:opacity-60 md:text-xl">
                {next.data.title}
              </span>
            </a>
          )
        }
      </div>
    </nav>

    <Footer />
  </main>
</BaseLayout>
